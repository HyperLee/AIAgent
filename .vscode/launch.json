{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug AIAgent.Cli",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build AIAgent.Cli",
      "program": "${workspaceFolder}/src/AIAgent.Cli/bin/Debug/net10.0/AIAgent.Cli.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "justMyCode": true,
      "internalConsoleOptions": "neverOpen",
      "logging": {
        "exceptions": false,
        "moduleLoad": false
      }
    }
  ]
}
