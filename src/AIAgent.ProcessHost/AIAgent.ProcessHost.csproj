<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="UseAppHost">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <DefineConstants>$(DefineConstants);GIT_PROCESS_HOST</DefineConstants>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AIAgent.Cli.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../AIAgent.Cli/Git/GitProcessContracts.cs" Link="GitProcessContracts.cs" />
    <Compile Include="../AIAgent.Cli/Git/GitProcessProtocol.cs" Link="GitProcessProtocol.cs" />
    <Compile Include="../AIAgent.Cli/Git/GitInstallation.cs" Link="GitInstallation.cs" />
  </ItemGroup>
</Project>
