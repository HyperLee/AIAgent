<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AIAgent.ProcessHost/AIAgent.ProcessHost.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Google.GenAI" Version="1.26.1" />
    <PackageReference Include="ModelContextProtocol.Core" Version="[2.3.0]" />
    <Content Include="../AIAgent.ProcessHost/bin/$(Configuration)/net10.0/AIAgent.ProcessHost" Link="ProcessHost/AIAgent.ProcessHost" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../AIAgent.ProcessHost/bin/$(Configuration)/net10.0/AIAgent.ProcessHost.dll" Link="ProcessHost/AIAgent.ProcessHost.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../AIAgent.ProcessHost/bin/$(Configuration)/net10.0/AIAgent.ProcessHost.deps.json" Link="ProcessHost/AIAgent.ProcessHost.deps.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../AIAgent.ProcessHost/bin/$(Configuration)/net10.0/AIAgent.ProcessHost.runtimeconfig.json" Link="ProcessHost/AIAgent.ProcessHost.runtimeconfig.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="AIAgent.Cli.Tests" />
    <InternalsVisibleTo Include="AIAgent.Cli.TerminalHost" />
  </ItemGroup>
  <Target Name="CopyProcessHost" AfterTargets="Build">
    <ItemGroup>
      <ProcessHostFiles Include="../AIAgent.ProcessHost/bin/$(Configuration)/net10.0/AIAgent.ProcessHost*" />
    </ItemGroup>
    <Copy SourceFiles="@(ProcessHostFiles)" DestinationFolder="$(OutDir)ProcessHost" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishProcessHost" AfterTargets="Publish">
    <ItemGroup>
      <PublishedProcessHostFiles Include="../AIAgent.ProcessHost/bin/$(Configuration)/net10.0/AIAgent.ProcessHost*" />
    </ItemGroup>
    <Copy SourceFiles="@(PublishedProcessHostFiles)" DestinationFolder="$(PublishDir)ProcessHost" SkipUnchangedFiles="true" />
  </Target>
</Project>
